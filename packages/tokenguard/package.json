{
  "name": "@cendor/tokenguard",
  "version": "0.2.6",
  "description": "Spending limits for LLM calls: stop a call before it runs if it would blow the budget, and see cost broken down per feature.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sinks": {
      "types": "./dist/sinks.d.ts",
      "default": "./dist/sinks.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": [
    "./dist/index.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@cendor/core": "workspace:^"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "keywords": [
    "llm",
    "budget",
    "cost",
    "governance",
    "cendor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cendorhq/cendor-libs-js.git",
    "directory": "packages/tokenguard"
  },
  "homepage": "https://cendor.ai/docs/tokenguard",
  "bugs": {
    "url": "https://github.com/cendorhq/cendor-libs-js/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
