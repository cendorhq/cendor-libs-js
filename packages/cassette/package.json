{
  "name": "@cendor/cassette",
  "version": "0.2.1",
  "description": "Record an agent run once, replay it forever — offline, deterministic, free. The TypeScript port of cendor.cassette.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@cendor/core": "workspace:^"
  },
  "keywords": [
    "llm",
    "testing",
    "record",
    "replay",
    "vcr",
    "cendor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cendorhq/cendor-libs-js.git",
    "directory": "packages/cassette"
  },
  "publishConfig": {
    "access": "public"
  }
}
