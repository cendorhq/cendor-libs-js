{
  "name": "@cendor/libs",
  "version": "0.2.1",
  "description": "All six Cendor libraries in one install — plain building blocks for LLM apps: context, cost, compression, testing, and a tamper-evident audit trail.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@cendor/acttrace": "workspace:^",
    "@cendor/cassette": "workspace:^",
    "@cendor/contextkit": "workspace:^",
    "@cendor/core": "workspace:^",
    "@cendor/squeeze": "workspace:^",
    "@cendor/tokenguard": "workspace:^"
  },
  "keywords": [
    "llm",
    "cendor",
    "meta",
    "umbrella"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cendorhq/cendor-libs-js.git",
    "directory": "packages/libs"
  },
  "publishConfig": {
    "access": "public"
  }
}
