{
  "name": "@cendor/contextkit",
  "version": "3.1.0",
  "description": "Fit a prompt into the model's token budget — add your messages and context, pin what must stay, and the least-important parts are dropped to make it fit.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "INTEGRATION.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cendor/core": "workspace:^"
  },
  "peerDependencies": {
    "@cendor/squeeze": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@cendor/squeeze": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cendor/squeeze": "workspace:^",
    "fast-check": "^3.23.2"
  },
  "keywords": [
    "llm",
    "context",
    "prompt",
    "tokens",
    "budget",
    "cendor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cendorhq/cendor-libs-js.git",
    "directory": "packages/contextkit"
  },
  "homepage": "https://cendor.ai/docs/contextkit",
  "bugs": {
    "url": "https://github.com/cendorhq/cendor-libs-js/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
