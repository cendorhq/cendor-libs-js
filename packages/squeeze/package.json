{
  "name": "@cendor/squeeze",
  "version": "0.3.5",
  "description": "Shrink long prompts to hit a token budget and expand them back exactly — the same input always produces the same output.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "default": "./dist/store.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "INTEGRATION.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@cendor/core": "workspace:^"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.1"
  },
  "keywords": [
    "llm",
    "context",
    "compression",
    "tokens",
    "cendor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cendorhq/cendor-libs-js.git",
    "directory": "packages/squeeze"
  },
  "homepage": "https://cendor.ai/docs/squeeze",
  "bugs": {
    "url": "https://github.com/cendorhq/cendor-libs-js/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "fast-check": "^3.23.2"
  }
}
