{
  "name": "@cendor/core",
  "version": "3.0.0",
  "description": "Wrap your LLM client once and capture exact token counts and cost on every call — the shared foundation the other Cendor tools build on.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./langchain": {
      "types": "./dist/langchain.d.ts",
      "default": "./dist/langchain.js"
    },
    "./openai-agents": {
      "types": "./dist/openai-agents.d.ts",
      "default": "./dist/openai-agents.js"
    },
    "./foundry": {
      "types": "./dist/foundry.d.ts",
      "default": "./dist/foundry.js"
    },
    "./agent-ids": {
      "types": "./dist/agent-ids.d.ts",
      "default": "./dist/agent-ids.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "INTEGRATION.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "js-tiktoken": "^1.0.15"
  },
  "peerDependencies": {
    "@azure/ai-agents": ">=1",
    "@langchain/core": ">=0.3",
    "@openai/agents": ">=0.1",
    "@opentelemetry/api": ">=1"
  },
  "peerDependenciesMeta": {
    "@azure/ai-agents": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@openai/agents": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "keywords": [
    "llm",
    "openai",
    "anthropic",
    "tokens",
    "cost",
    "instrument",
    "cendor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cendorhq/cendor-libs-js.git",
    "directory": "packages/core"
  },
  "homepage": "https://cendor.ai/docs/core",
  "bugs": {
    "url": "https://github.com/cendorhq/cendor-libs-js/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@azure/ai-agents": "^1.1.0",
    "@langchain/core": "^1.2.3",
    "@openai/agents": "^0.13.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.1.0",
    "@opentelemetry/sdk-trace-base": "^2.1.0"
  }
}
