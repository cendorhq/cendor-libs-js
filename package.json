{
  "name": "cendor-libs-js",
  "version": "0.0.0",
  "private": true,
  "description": "Production plumbing for LLM applications — the TypeScript port of the Cendor libraries.",
  "type": "module",
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && rimraf packages/*/dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "check:types": "tsc -p tsconfig.typetests.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "fixtures": "cd ../cendor-libs && uv run python ../cendor-libs-js/scripts/gen-fixtures.py && uv run python ../cendor-libs-js/scripts/gen-fixtures-io.py",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@changesets/cli": "^2.31.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.1",
    "better-sqlite3": "^12.11.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "license": "Apache-2.0"
}
